{
  "name": "@codespring-app/use-agent",
  "version": "0.11.1",
  "description": "Server and React SDKs for the CodeSpring Agents runtime",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeSpringApp/use-agent-sdk.git"
  },
  "homepage": "https://github.com/CodeSpringApp/use-agent-sdk#readme",
  "bugs": {
    "url": "https://github.com/CodeSpringApp/use-agent-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "skills",
    "docs/screenshots",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./mcp-apps": {
      "types": "./dist/mcp-apps.d.ts",
      "import": "./dist/mcp-apps.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "use-agent": "./dist/bin/use-agent.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/react.tsx src/mcp-apps.tsx src/cli.ts src/node.ts src/bin/use-agent.ts --format esm --dts --clean --out-dir dist && chmod +x dist/bin/use-agent.js",
    "showcase": "vite examples/showcase --host 127.0.0.1",
    "showcase:build": "vite build examples/showcase --outDir ../../dist-showcase --emptyOutDir",
    "example:live": "bun run examples/live-session-replay.ts",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "jose": "^6.2.10",
    "shiki": "4.4.3",
    "streamdown": "2.6.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
